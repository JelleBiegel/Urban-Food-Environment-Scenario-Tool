{
  "name": "Urban Food Environment Scenario Tool",

  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": [
    "app",
    "gama"
  ],

  "workspaceFolder": "/workspaces/Urban-Food-Environment-Scenario-Tool",

  "forwardPorts": [
    8503
  ],

  "portsAttributes": {
    "8503": {
      "label": "Scenario Tool",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },

  "postCreateCommand": "python -m pip install -r requirements.txt",

  "postStartCommand": "nohup python -m streamlit run app.py --server.address 0.0.0.0 --server.port 8503 > /tmp/streamlit.log 2>&1 &",

  "shutdownAction": "stopCompose"
}
